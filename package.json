{
  "name": "dsh-fish-world",
  "version": "0.2.0",
  "description": "鱼的世界：给 DSH 的整合养鱼插件 —— 记忆、日记、心情、关系网络，以及默认关闭的 QQ（dsh-qq-bridge / AstrBot 两种接法）、B 站、抖音能力。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "ui",
    "client.js",
    "cordis.patch.yml",
    "LICENSE",
    "THIRD-PARTY-NOTICES.md",
    "README.md",
    "CHANGELOG.md",
    "examples",
    "scripts"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-plugins"
      ]
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "qq",
    "qq-agent",
    "fish-world",
    "diary",
    "relationships",
    "rpg-state",
    "fish-memory",
    "bilibili",
    "whale-widget",
    "onebot"
  ],
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/1838601405/dsh-fish-world.git"
  },
  "homepage": "https://github.com/1838601405/dsh-fish-world#readme",
  "bugs": {
    "url": "https://github.com/1838601405/dsh-fish-world/issues"
  },
  "dependencies": {
    "sharp": "^0.35.5"
  },
  "peerDependencies": {
    "dsh-qq-bridge": "github:Yuuyuko-uu/dsh-qq-bridge",
    "dsh-feiyu-mood": "github:Yuuyuko-uu/dsh-feiyu-mood",
    "dsh-fish-memory": "github:Yuuyuko-uu/dsh-fish-memory",
    "dsh-bili-subagent": "github:Yuuyuko-uu/dsh-bili-subagent",
    "dsh-tts-bridge": "github:Yuuyuko-uu/dsh-tts-bridge",
    "dsh-wechat-plugin": "^0.47.0"
  },
  "peerDependenciesMeta": {
    "dsh-qq-bridge": { "optional": true },
    "dsh-feiyu-mood": { "optional": true },
    "dsh-fish-memory": { "optional": true },
    "dsh-bili-subagent": { "optional": true },
    "dsh-tts-bridge": { "optional": true },
    "dsh-wechat-plugin": { "optional": true }
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "check": "node scripts/check.mjs && node scripts/check-ui.mjs",
    "preview:ui": "node scripts/preview-ui.mjs",
    "repair:auth": "node scripts/repair-desktop-auth.mjs",
    "auth:check": "node scripts/repair-desktop-auth.mjs --check",
    "auth:watchdog": "node scripts/auth-watchdog.mjs",
    "auth:clean": "node scripts/auth-watchdog.mjs --once",
    "doctor": "node scripts/doctor.mjs",
    "install:desktop": "node scripts/install-desktop.mjs"
  },
  "license": "GPL-3.0-only"
}
